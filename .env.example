# Both are optional. Without them the app uses the free Esri imagery.

# Sharper satellite imagery from Google. Needs billing enabled on your Google
# Cloud project, and is charged per use. Google's terms require showing their
# attribution and forbid storing their tiles.
GOOGLE_MAPS_API_KEY=

# Bing satellite imagery through Cesium ion. Free tier available.
CESIUM_ION_TOKEN=
